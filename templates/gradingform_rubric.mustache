<div id="rubric-{{elementname}}" class="clearfix gradingform_rubric{{uniqid}}">
    <div class="criteria" id="{{elementname}}-criteria" style="display: block">
        {{{criteriastr}}}
    </div>
    {{#addcriterion}}
        <div class="addcrierion btn btn-primary">
            <input
                type="submit"
                name="{{elementname}}[criteria][addcriterion]"
                id="{{elementname}}-criteria-addcriterion"
                value="{{#str}}addcriterion, gradingform_rubric{{/str}}"/>
        </div>
    {{/addcriterion}}
    {{#editoptions}}
        {{{.}}}
    {{/editoptions}}
</div>
{{#js}}
require(['core/auto_rows'], function(AutoRows) {
    AutoRows.init(document.getElementById('gradingform_rubric-{{uniqid}}'));
});
{{/js}}